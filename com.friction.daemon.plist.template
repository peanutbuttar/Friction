<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.friction.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>friction</string>
        <string>daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- The point of the whole thing: killing it does not stop enforcement. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer restarts if it's crash-looping. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__REPO__/frictiond.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/frictiond.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
